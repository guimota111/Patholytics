rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user document is private to its owner. Nobody else reads or writes it,
    // and there is no listing of the collection.
    match /users/{uid} {
      allow read: if isOwner(uid);

      // Creation happens client-side on first sign-in. The document must be
      // owned by the caller and must start on the free plan — a client cannot
      // grant itself a paid plan before billing exists.
      allow create: if isOwner(uid)
                    && incoming().plan == 'free'
                    && incoming().language is string
                    && incoming().displayName is string;

      // Only profile fields are writable. `plan` and `createdAt` are excluded,
      // so upgrades will have to come from a trusted backend later.
      allow update: if isOwner(uid)
                    && changedKeys().hasOnly(['displayName', 'language', 'photoURL', 'updatedAt']);

      allow delete: if false;
    }

    // Organizador de casos. Listas e casos sao dados de trabalho do proprio
    // usuario: sem campo reservado, sem leitura cruzada, sem listagem por
    // fora do dono. As regras ficam largas de proposito — todo o conteudo e
    // livre e so o dono escreve.
    match /users/{uid}/caseLists/{listId} {
      allow read, write: if isOwner(uid);

      match /cases/{caseId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Arquivo de laudos: arvore de categorias, laudos e notas do proprio
    // usuario. Mesmo criterio do organizador — conteudo livre, so o dono le e
    // escreve, nenhum campo reservado.
    match /users/{uid}/archive/{nodeId} {
      allow read, write: if isOwner(uid);
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
  }
}
