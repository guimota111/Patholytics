rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user document is private to its owner. Nobody else reads or writes it,
    // and there is no listing of the collection.
    match /users/{uid} {
      allow read: if isOwner(uid);

      // Creation happens client-side on first sign-in. The document must be
      // owned by the caller and must start on the free plan — a client cannot
      // grant itself a paid plan before billing exists.
      allow create: if isOwner(uid)
                    && incoming().plan == 'free'
                    && incoming().language is string
                    && incoming().displayName is string;

      // Only profile fields are writable. `plan` and `createdAt` are excluded,
      // so upgrades will have to come from a trusted backend later.
      allow update: if isOwner(uid)
                    && changedKeys().hasOnly(['displayName', 'language', 'photoURL', 'updatedAt']);

      allow delete: if false;
    }

    // Arquivo de laudos: arvore de categorias, laudos e notas do proprio
    // usuario. Dados de trabalho: conteudo livre, sem campo reservado, sem
    // leitura cruzada e sem listagem por fora do dono.
    match /users/{uid}/archive/{nodeId} {
      allow read, write: if isOwner(uid);
    }

    // Congelacao: os modelos salvos do proprio usuario (um documento com a
    // lista). O laudo em curso nao passa pelo servidor.
    match /users/{uid}/frozen/{docId} {
      allow read, write: if isOwner(uid);
    }

    // Catálogos (bichos, corpos estranhos): fotos que os usuários mandam para
    // a curadoria. Quem está logado só cria, em nome próprio e dentro do
    // tamanho; ninguém lê pelo cliente — a curadoria é feita no console.
    match /submissions/{id} {
      allow create: if request.auth != null
                    && incoming().uid == request.auth.uid
                    && incoming().catalog in ['bugs', 'foreign']
                    && incoming().status == 'pending'
                    && incoming().subject is string && incoming().subject.size() <= 200
                    && incoming().site is string && incoming().site.size() <= 200
                    && incoming().notes is string && incoming().notes.size() <= 2000
                    && incoming().credit is string && incoming().credit.size() <= 120
                    && incoming().image is string && incoming().image.size() <= 900000;
      allow read, update, delete: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
  }
}
